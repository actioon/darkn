#!/usr/bin/python3
"""Darkn OS: Notification Sounds.

Give an app, or a group of apps, its own notification sound. The rules are
saved to ~/.config/darkn/notification-sounds.json and picked up at once by
the darkn-notify-sound service.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

from PyQt6.QtCore import QByteArray, QRectF, QSize, Qt, pyqtSignal
from PyQt6.QtGui import QColor, QFont, QIcon, QPainter, QPixmap
from PyQt6.QtSvg import QSvgRenderer
from PyQt6.QtWidgets import (
    QAbstractButton, QAbstractItemView, QApplication, QComboBox, QFileDialog, QFrame,
    QHBoxLayout, QLabel, QLineEdit, QListWidget, QListWidgetItem, QPushButton, QSlider,
    QStackedWidget, QVBoxLayout, QWidget,
)

HOME = Path.home()
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "darkn" / "notification-sounds.json"
STATE_FILE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "darkn" / "notification-apps.json"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share")
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "darkn" / "notification-sounds"

APP_DIRS = [
    Path("/usr/share/applications"),
    Path("/var/lib/flatpak/exports/share/applications"),
    DATA_HOME / "flatpak" / "exports" / "share" / "applications",
    DATA_HOME / "applications",
]
SOUND_DIRS = [Path("/usr/share/sounds"), DATA_HOME / "sounds", DATA_HOME / "darkn" / "sounds"]
SOUND_SUFFIXES = {".oga", ".ogg", ".wav", ".flac", ".mp3"}

DEFAULT_CONFIG = {"enabled": True, "play_during_dnd": True, "default": None, "rules": []}


# --- data ------------------------------------------------------------------

def load_config():
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return {**DEFAULT_CONFIG, **data}
    except (OSError, ValueError):
        pass
    return json.loads(json.dumps(DEFAULT_CONFIG))


def save_config(config):
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG_FILE)


def read_desktop_entry(path):
    """Name of a .desktop file's app, or None if it is hidden or not an app."""
    name, hidden, kind, in_main = "", False, "Application", False
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if line.startswith("["):
                if in_main:
                    break
                in_main = line == "[Desktop Entry]"
            elif in_main and "=" in line:
                key, value = line.split("=", 1)
                if key == "Name":
                    name = value
                elif key in ("NoDisplay", "Hidden") and value.lower() == "true":
                    hidden = True
                elif key == "Type":
                    kind = value
    except OSError:
        return None
    if kind != "Application" or hidden or not name:
        return None
    return name


def list_apps():
    """Apps to offer: those that have sent notifications first, then installed ones."""
    apps = {}
    try:
        seen = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        for entry in seen.values():
            app_id = str(entry.get("id", ""))
            if app_id:
                apps[app_id.lower()] = {"id": app_id, "name": str(entry.get("name") or app_id), "seen": True}
    except (OSError, ValueError, AttributeError):
        pass
    for folder in APP_DIRS:
        if not folder.is_dir():
            continue
        for path in folder.glob("*.desktop"):
            name = read_desktop_entry(path)
            if not name:
                continue
            key = path.stem.lower()
            if key in apps:
                apps[key]["name"] = name
            elif not any(a["name"].lower() == name.lower() for a in apps.values()):
                apps[key] = {"id": path.stem, "name": name, "seen": False}
    return sorted(apps.values(), key=lambda a: (not a["seen"], a["name"].lower()))


def list_sounds():
    sounds = []
    for folder in SOUND_DIRS:
        if not folder.is_dir():
            continue
        for path in folder.rglob("*"):
            if path.suffix.lower() in SOUND_SUFFIXES and path.is_file():
                relative = path.relative_to(folder)
                theme = relative.parts[0] if len(relative.parts) > 1 else "My sounds"
                sounds.append((f"{pretty(path.stem)}  ·  {theme}", str(path)))
    return sorted(set(sounds), key=lambda s: s[0].lower())


def pretty(stem):
    return stem.replace("-", " ").replace("_", " ").strip().capitalize()


def play_sound(path, volume):
    if not path or not Path(path).is_file():
        return
    if shutil.which("pw-play"):
        cmd = ["pw-play", "--volume", f"{volume:.2f}", path]
    elif shutil.which("paplay"):
        cmd = ["paplay", f"--volume={int(volume * 65536)}", path]
    else:
        return
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


