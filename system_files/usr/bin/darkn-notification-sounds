# --- widgets ---------------------------------------------------------------

class Toggle(QAbstractButton):
    """A switch."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCheckable(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFixedSize(38, 22)

    def sizeHint(self):
        return QSize(38, 22)

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setPen(Qt.PenStyle.NoPen)
        on = self.isChecked()
        painter.setBrush(QColor("#f1f1f2" if on else "#2f2f33"))
        painter.drawRoundedRect(QRectF(0, 0, 38, 22), 11, 11)
        painter.setBrush(QColor("#111112" if on else "#9a9aa0"))
        painter.drawEllipse(QRectF(19 if on else 3, 3, 16, 16))
        painter.end()


def label(text, name=None, wrap=False):
    widget = QLabel(text)
    if name:
        widget.setObjectName(name)
    widget.setWordWrap(wrap)
    return widget


def icon_tile(name, size=34):
    tile = QFrame()
    tile.setObjectName("tile")
    tile.setFixedSize(size, size)
    glyph = QLabel(tile)
    glyph.setPixmap(icon(name, TEXT, 18).pixmap(18, 18))
    glyph.setAlignment(Qt.AlignmentFlag.AlignCenter)
    glyph.setGeometry(0, 0, size, size)
    return tile


def ghost_button(name, tip):
    button = QPushButton(icon(name, MUTED, 18), "")
    button.setObjectName("ghost")
    button.setIconSize(QSize(18, 18))
    button.setToolTip(tip)
    button.setCursor(Qt.CursorShape.PointingHandCursor)
    return button


def divider():
    line = QFrame()
    line.setObjectName("divider")
    line.setFixedHeight(1)
    return line


class RuleRow(QWidget):
    """One entry of the rule list: icon, name, summary and an on/off switch."""

    toggled = pyqtSignal(bool)

    def __init__(self, icon_name, parent=None):
        super().__init__(parent)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.title = label("", "rowTitle")
        self.sub = label("", "rowSub")
        text = QVBoxLayout()
        text.setSpacing(1)
        text.setContentsMargins(0, 0, 0, 0)
        text.addWidget(self.title)
        text.addWidget(self.sub)
        self.switch = Toggle()
        self.switch.toggled.connect(self.toggled)
        row = QHBoxLayout(self)
        row.setContentsMargins(9, 8, 10, 8)
        row.setSpacing(11)
        row.addWidget(icon_tile(icon_name))
        row.addLayout(text, 1)
        row.addWidget(self.switch)

    def update_text(self, title, sub, on):
        self.title.setText(title)
        self.sub.setText(sub)
        self.switch.blockSignals(True)
        self.switch.setChecked(on)
        self.switch.blockSignals(False)


class SoundPicker(QWidget):
    """Sound drop-down with Browse, Play and a volume slider."""

    changed = pyqtSignal()

    def __init__(self, sounds, parent=None):
        super().__init__(parent)
        self.combo = QComboBox()
        self.combo.setMinimumWidth(220)
        self.combo.addItem("No sound", "")
        for text, path in sounds:
            self.combo.addItem(text, path)

        browse = QPushButton(icon("folder", TEXT, 16), " Browse")
        browse.clicked.connect(self._browse)
        play = QPushButton(icon("play", "#111112", 16), "")
        play.setObjectName("round")
        play.setToolTip("Play")
        play.setCursor(Qt.CursorShape.PointingHandCursor)
        play.clicked.connect(lambda: play_sound(self.sound(), self.volume()))

        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(10, 150)
        self.slider.setValue(100)
        self.percent = label("100%", "muted")
        self.percent.setFixedWidth(42)
        self.percent.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        self.slider.valueChanged.connect(lambda v: self.percent.setText(f"{v}%"))

        top = QHBoxLayout()
        top.setSpacing(8)
        top.addWidget(self.combo, 1)
        top.addWidget(browse)
        top.addWidget(play)
        volume_icon = QLabel()
        volume_icon.setPixmap(icon("volume", MUTED, 18).pixmap(18, 18))
        bottom = QHBoxLayout()
        bottom.setSpacing(10)
        bottom.addWidget(volume_icon)
        bottom.addWidget(self.slider, 1)
        bottom.addWidget(self.percent)
        rows = QVBoxLayout(self)
        rows.setContentsMargins(0, 0, 0, 0)
        rows.setSpacing(12)
        rows.addLayout(top)
        rows.addLayout(bottom)

        self.combo.currentIndexChanged.connect(lambda *_: self.changed.emit())
        self.slider.valueChanged.connect(lambda *_: self.changed.emit())

    def _browse(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Choose a sound", str(HOME), "Sounds (*.oga *.ogg *.wav *.flac *.mp3)")
        if path:
            self.set_sound(path)

    def sound(self):
        return self.combo.currentData() or ""

    def volume(self):
        return self.slider.value() / 100

    def load(self, sound, volume):
        self.blockSignals(True)
        self.set_sound(sound or "")
        self.slider.setValue(int(round(float(volume or 1.0) * 100)))
        self.blockSignals(False)

    def set_sound(self, path):
        index = self.combo.findData(path) if path else 0
        if index < 0:
            self.combo.addItem(f"{Path(path).name}  ·  file", path)
            index = self.combo.count() - 1
        self.combo.setCurrentIndex(index)


class MainWindow(QWidget):
    DEFAULT = "default"  # list entry for "every other app"

    def __init__(self):
        super().__init__()
        self.setObjectName("root")
        self.setWindowTitle("Notification Sounds")
        self.setWindowIcon(QIcon.fromTheme("preferences-desktop-notification-bell"))
        self.resize(1000, 680)
        self.setMinimumSize(860, 560)

        self.config = load_config()
        self.sounds = list_sounds()
        self.all_apps = list_apps()
        self._loading = False
        self.rows = []

        root = QVBoxLayout(self)
        root.setContentsMargins(16, 14, 16, 16)
        root.setSpacing(14)
        root.addLayout(self._build_header())
        body = QHBoxLayout()
        body.setSpacing(14)
        body.addWidget(self._build_sidebar())
        body.addWidget(self._build_editor(), 1)
        root.addLayout(body, 1)

        self._refresh_list(select=0 if self.config["rules"] else None)

    # layout

    def _build_header(self):
        self.enabled = Toggle()
        self.enabled.setChecked(bool(self.config.get("enabled", True)))
        self.enabled.toggled.connect(self._options_changed)
        self.dnd = Toggle()
        self.dnd.setChecked(bool(self.config.get("play_during_dnd", True)))
        self.dnd.toggled.connect(self._options_changed)

        titles = QVBoxLayout()
        titles.setSpacing(0)
        titles.addWidget(label("Notification Sounds", "appTitle"))
        titles.addWidget(label("A different sound for each app or group of apps", "muted"))

        header = QHBoxLayout()
        header.setSpacing(12)
        header.addWidget(icon_tile("bell", 40))
        header.addLayout(titles)
        header.addStretch(1)
        moon = QLabel()
        moon.setPixmap(icon("moon", MUTED, 16).pixmap(16, 16))
        header.addWidget(moon)
        header.addWidget(label("Play during Do Not Disturb", "muted"))
        header.addWidget(self.dnd)
        header.addSpacing(14)
        header.addWidget(label("Custom sounds", "muted"))
        header.addWidget(self.enabled)
        return header

    def _build_sidebar(self):
        card = QFrame()
        card.setObjectName("card")
        card.setFixedWidth(330)

        add = ghost_button("plus", "Add rule")
        add.clicked.connect(self.add_rule)
        top = QHBoxLayout()
        top.setContentsMargins(16, 12, 10, 10)
        top.addWidget(label("Rules", "heading"))
        top.addStretch(1)
        top.addWidget(add)

        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Search…")
        self.search.textChanged.connect(self._filter_rules)
        glass = QLabel()
        glass.setPixmap(icon("search", MUTED, 17).pixmap(17, 17))
        search_row = QHBoxLayout()
        search_row.setContentsMargins(16, 0, 14, 0)
        search_row.setSpacing(9)
        search_row.addWidget(glass)
        search_row.addWidget(self.search, 1)

        self.rule_list = QListWidget()
        self.rule_list.setVerticalScrollMode(QAbstractItemView.ScrollMode.ScrollPerPixel)
        self.rule_list.currentItemChanged.connect(lambda *_: self._show_current())
        list_box = QVBoxLayout()
        list_box.setContentsMargins(8, 8, 8, 8)
        list_box.addWidget(self.rule_list)

        layout = QVBoxLayout(card)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        layout.addLayout(top)
        layout.addWidget(divider())
        layout.addLayout(search_row)
        layout.addWidget(divider())
        layout.addLayout(list_box, 1)
        return card

    def _build_editor(self):
        card = QFrame()
        card.setObjectName("card")
        self.pages = QStackedWidget()
        self.pages.addWidget(self._page_empty())
        self.pages.addWidget(self._page_rule())
        self.pages.addWidget(self._page_default())
        layout = QVBoxLayout(card)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.pages)
        return card

    def _page_empty(self):
        page = QWidget()
        button = QPushButton(icon("plus", "#111112", 16), " Add rule")
        button.setObjectName("primary")
        button.setCursor(Qt.CursorShape.PointingHandCursor)
        button.clicked.connect(self.add_rule)
        title = label("No rules yet", "emptyTitle")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        text = label("Create a rule, pick the apps, choose a sound.", "muted")
        text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout = QVBoxLayout(page)
        layout.addStretch(1)
        layout.addWidget(icon_tile("bell", 46), 0, Qt.AlignmentFlag.AlignHCenter)
        layout.addSpacing(10)
        layout.addWidget(title)
        layout.addWidget(text)
        layout.addSpacing(12)
        layout.addWidget(button, 0, Qt.AlignmentFlag.AlignHCenter)
        layout.addStretch(1)
        return page

    def _page_rule(self):
        page = QWidget()
        self.name = QLineEdit()
        self.name.setObjectName("ruleName")
        self.name.setPlaceholderText("Rule name")
        self.name.textEdited.connect(self._rule_edited)

        up = ghost_button("up", "Move up")
        up.clicked.connect(lambda: self.move_rule(-1))
        down = ghost_button("down", "Move down")
        down.clicked.connect(lambda: self.move_rule(1))
        remove = QPushButton(icon("trash", DANGER, 16), " Remove")
        remove.setObjectName("danger")
        remove.setCursor(Qt.CursorShape.PointingHandCursor)
        remove.clicked.connect(self.remove_rule)
        title_row = QHBoxLayout()
        title_row.setSpacing(4)
        title_row.addWidget(self.name, 1)
        title_row.addWidget(up)
        title_row.addWidget(down)
        title_row.addWidget(remove)

        self.picker = SoundPicker(self.sounds)
        self.picker.changed.connect(self._rule_edited)

        self.app_search = QLineEdit()
        self.app_search.setPlaceholderText("Search apps…")
        self.app_search.setClearButtonEnabled(True)
        self.app_search.textChanged.connect(self._filter_apps)
        self.app_count = label("", "muted")
        apps_head = QHBoxLayout()
        apps_head.addWidget(label("APPS", "section"))
        apps_head.addStretch(1)
        apps_head.addWidget(self.app_count)

        self.apps = QListWidget()
        self.apps.setObjectName("apps")
        self.apps.setVerticalScrollMode(QAbstractItemView.ScrollMode.ScrollPerPixel)
        self.apps.itemChanged.connect(self._rule_edited)

        self.manual = QLineEdit()
        self.manual.setPlaceholderText("App not listed? Type its name and press Enter")
        self.manual.returnPressed.connect(self._add_manual_app)

        layout = QVBoxLayout(page)
        layout.setContentsMargins(20, 16, 20, 18)
        layout.setSpacing(10)
        layout.addLayout(title_row)
        layout.addSpacing(4)
        layout.addWidget(label("SOUND", "section"))
        layout.addWidget(self.picker)
        layout.addSpacing(8)
        layout.addLayout(apps_head)
        layout.addWidget(self.app_search)
        layout.addWidget(self.apps, 1)
        layout.addWidget(self.manual)
        return page

    def _page_default(self):
        page = QWidget()
        self.default_picker = SoundPicker(self.sounds)
        self.default_picker.changed.connect(self._default_edited)
        note = label("Used for apps that have no rule of their own. Chat apps such as Telegram and "
                     "Discord also play their own sound; turn that off inside the app, or you will "
                     "hear two sounds.", "muted", wrap=True)
        layout = QVBoxLayout(page)
        layout.setContentsMargins(20, 16, 20, 18)
        layout.setSpacing(10)
        title = label("Every other app")
        title.setStyleSheet("font-size: 20px; font-weight: 600; padding: 5px 6px;")
        layout.addWidget(title)
        layout.addSpacing(4)
        layout.addWidget(label("SOUND", "section"))
        layout.addWidget(self.default_picker)
        layout.addSpacing(10)
        layout.addWidget(note)
        layout.addStretch(1)
        return page

    # rule list

    def _summary(self, rule):
        apps = rule.get("apps", [])
        count = f"{len(apps)} app" + ("" if len(apps) == 1 else "s")
        sound = pretty(Path(rule.get("sound", "")).stem) if rule.get("sound") else "No sound"
        return f"{count}  ·  {sound}"

    def _refresh_list(self, select=None):
        self._loading = True
        self.rule_list.clear()
        self.rows = []
        for index, rule in enumerate(self.config["rules"]):
            row = RuleRow("bell")
            row.update_text(rule.get("name") or "Untitled rule", self._summary(rule), rule.get("enabled", True))
            row.toggled.connect(lambda on, i=index: self._rule_toggled(i, on))
            self._append_row(row, index)
        default = self.config.get("default") or {}
        row = RuleRow("layers")
        row.update_text("Every other app",
                        pretty(Path(default.get("sound", "")).stem) if default.get("sound") else "No sound",
                        bool(default.get("enabled", False)))
        row.toggled.connect(self._default_toggled)
        self._append_row(row, self.DEFAULT)
        self._loading = False

        if select is None:
            self.rule_list.setCurrentRow(-1)
            self.pages.setCurrentIndex(0 if not self.config["rules"] else self.pages.currentIndex())
            if not self.config["rules"]:
                self.pages.setCurrentIndex(0)
        else:
            self.rule_list.setCurrentRow(select)
        self._filter_rules(self.search.text())

    def _append_row(self, row, key):
        item = QListWidgetItem()
        item.setData(Qt.ItemDataRole.UserRole, key)
        item.setSizeHint(QSize(0, 54))
        self.rule_list.addItem(item)
        self.rule_list.setItemWidget(item, row)
        self.rows.append(row)

    def _filter_rules(self, text):
        text = text.lower()
        for index in range(self.rule_list.count()):
            row = self.rows[index]
            match = text in row.title.text().lower() or text in row.sub.text().lower()
            self.rule_list.item(index).setHidden(bool(text) and not match)

    def current_key(self):
        item = self.rule_list.currentItem()
        return item.data(Qt.ItemDataRole.UserRole) if item else None

    def _show_current(self):
        if self._loading:
            return
        key = self.current_key()
        if key is None:
            self.pages.setCurrentIndex(0)
        elif key == self.DEFAULT:
            default = self.config.get("default") or {}
            self.default_picker.load(default.get("sound", ""), default.get("volume", 1.0))
            self.pages.setCurrentIndex(2)
        else:
            self._load_rule(self.config["rules"][key])
            self.pages.setCurrentIndex(1)

    # rule editor

    def _load_rule(self, rule):
        self._loading = True
        self.name.setText(rule.get("name", ""))
        self.picker.load(rule.get("sound", ""), rule.get("volume", 1.0))
        chosen = {str(a.get("id", "")).lower(): a for a in rule.get("apps", [])}
        self.apps.clear()
        known = set()
        for app in self.all_apps:
            known.add(app["id"].lower())
            self._add_app_item(app, app["id"].lower() in chosen)
        for key, app in chosen.items():  # apps typed in by hand
            if key not in known:
                self._add_app_item({"id": app.get("id", ""), "name": app.get("name") or app.get("id", "")}, True)
        self.app_search.clear()
        self._loading = False
        self._update_app_count()

    def _add_app_item(self, app, checked):
        item = QListWidgetItem(app["name"])
        item.setData(Qt.ItemDataRole.UserRole, {"id": app["id"], "name": app["name"]})
        item.setFlags((item.flags() | Qt.ItemFlag.ItemIsUserCheckable) & ~Qt.ItemFlag.ItemIsSelectable)
        item.setCheckState(Qt.CheckState.Checked if checked else Qt.CheckState.Unchecked)
        if app.get("seen"):
            item.setToolTip(f"{app['id']} — has sent notifications before")
        else:
            item.setToolTip(app["id"])
        self.apps.addItem(item)
        return item

    def _add_manual_app(self):
        text = self.manual.text().strip()
        if not text or self.current_key() in (None, self.DEFAULT):
            return
        self.manual.clear()
        item = self._add_app_item({"id": text, "name": text}, True)
        self.apps.scrollToItem(item)

    def _filter_apps(self, text):
        text = text.lower()
        for row in range(self.apps.count()):
            item = self.apps.item(row)
            item.setHidden(text not in item.text().lower())

    def _selected_apps(self):
        return [self.apps.item(r).data(Qt.ItemDataRole.UserRole)
                for r in range(self.apps.count())
                if self.apps.item(r).checkState() == Qt.CheckState.Checked]

    def _update_app_count(self):
        count = len(self._selected_apps())
        self.app_count.setText(f"{count} selected")

    def _rule_edited(self, *_):
        key = self.current_key()
        if self._loading or key in (None, self.DEFAULT):
            return
        rule = self.config["rules"][key]
        rule["name"] = self.name.text().strip()
        rule["sound"] = self.picker.sound()
        rule["volume"] = self.picker.volume()
        rule["apps"] = self._selected_apps()
        self._update_app_count()
        self.rows[key].update_text(rule["name"] or "Untitled rule", self._summary(rule), rule.get("enabled", True))
        save_config(self.config)

    def _rule_toggled(self, index, on):
        self.config["rules"][index]["enabled"] = on
        save_config(self.config)

    # actions

    def add_rule(self):
        self.search.clear()
        self.config["rules"].append({"name": "New rule", "enabled": True, "apps": [], "sound": "", "volume": 1.0})
        save_config(self.config)
        self._refresh_list(select=len(self.config["rules"]) - 1)
        self.name.setFocus()
        self.name.selectAll()

    def remove_rule(self):
        key = self.current_key()
        if key in (None, self.DEFAULT):
            return
        del self.config["rules"][key]
        save_config(self.config)
        remaining = len(self.config["rules"])
        self._refresh_list(select=min(key, remaining - 1) if remaining else None)

    def move_rule(self, step):
        key = self.current_key()
        rules = self.config["rules"]
        if key in (None, self.DEFAULT) or not 0 <= key + step < len(rules):
            return
        rules[key], rules[key + step] = rules[key + step], rules[key]
        save_config(self.config)
        self._refresh_list(select=key + step)

    # everything else, and global options

    def _default_edited(self):
        if self._loading:
            return
        default = self.config.get("default") or {}
        self.config["default"] = {
            "enabled": bool(default.get("enabled", False)) or not default,
            "sound": self.default_picker.sound(),
            "volume": self.default_picker.volume(),
        }
        row = self.rows[-1]
        row.update_text("Every other app",
                        pretty(Path(self.default_picker.sound()).stem) if self.default_picker.sound() else "No sound",
                        self.config["default"]["enabled"])
        save_config(self.config)

    def _default_toggled(self, on):
        default = dict(self.config.get("default") or {"sound": "", "volume": 1.0})
        default["enabled"] = on
        self.config["default"] = default
        save_config(self.config)

    def _options_changed(self, *_):
        self.config["enabled"] = self.enabled.isChecked()
        self.config["play_during_dnd"] = self.dnd.isChecked()
        save_config(self.config)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Notification Sounds")
    app.setDesktopFileName("darkn-notification-sounds")
    font = QFont()
    font.setFamilies(["Inter", "Noto Sans", "Segoe UI", "sans-serif"])
    font.setPointSize(10)
    app.setFont(font)
    app.setStyleSheet(style_sheet())
    window = MainWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
