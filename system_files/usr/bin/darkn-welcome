def white(alpha):
    """Translucent white for style sheets; alpha is 0 to 255."""
    return f"rgba(255, 255, 255, {alpha})"


def svg(name, color, width=1.7):
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" '
            f'fill="none" stroke="{color}" stroke-width="{width}" stroke-linecap="round" '
            f'stroke-linejoin="round">{ICONS[name]}</svg>')


def pixmap(name, color=TEXT, size=18, width=1.7):
    image = QPixmap(size * 2, size * 2)
    image.fill(Qt.GlobalColor.transparent)
    painter = QPainter(image)
    QSvgRenderer(QByteArray(svg(name, color, width).encode())).render(painter, QRectF(0, 0, size * 2, size * 2))
    painter.end()
    image.setDevicePixelRatio(2)
    return image


def icon(name, color=TEXT, size=18):
    return QIcon(pixmap(name, color, size))


