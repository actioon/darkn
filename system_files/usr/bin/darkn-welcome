def card_size(width, height):
    """Size of the glass card in a window of the given size.

    A small window is filled up to a thin margin. On a big screen the card
    stays a centred panel, so pages keep comfortable line lengths; it grows
    a little with the screen but never stretches from edge to edge.
    """
    widest = max(1560, min(1720, int(width * 0.64)))
    tallest = max(900, min(1040, int(height * 0.70)))
    return min(width - 2 * MARGIN, widest), min(height - 2 * MARGIN, tallest)

