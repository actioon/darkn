#!/usr/bin/python3
"""Darkn OS: Setup.

The first-run wizard: keyboard layouts, time zone, a hardware check, which
apps and developer tools to install, and backups. Nothing is installed unless
it is chosen here. The choices are saved under ~/.config/darkn and the apps
are installed by /usr/libexec/darkn-installer, whose progress is shown live.

  darkn-welcome              open the wizard, maximized (also reachable as darkn-setup)
  darkn-welcome --autostart  first login: open it full screen, and only if setup was never finished
"""

import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CONFIG_DIR = CONFIG_HOME / "darkn"
DONE_FILE = CONFIG_DIR / "welcome-done"

# Checked before Qt is loaded: this runs at every login.
if __name__ == "__main__" and "--autostart" in sys.argv[1:] and DONE_FILE.exists():
    sys.exit(0)

from PyQt6.QtCore import QByteArray, QEvent, QPointF, QProcess, QRectF, QSize, Qt, QThread, QTimer, pyqtSignal
from PyQt6.QtGui import (
    QBrush, QColor, QFont, QGuiApplication, QIcon, QImage, QImageReader, QKeySequence, QLinearGradient,
    QPainter, QPainterPath, QPalette, QPen, QPixmap, QRadialGradient, QShortcut,
)
from PyQt6.QtSvg import QSvgRenderer
from PyQt6.QtWidgets import (
    QAbstractButton, QAbstractItemView, QApplication, QBoxLayout, QButtonGroup, QFileDialog, QFrame, QGridLayout,
    QHBoxLayout, QLabel, QLayout, QLineEdit, QListWidget, QMessageBox, QPlainTextEdit, QPushButton,
    QScrollArea, QSizePolicy, QSlider, QStackedWidget, QStyleOption, QVBoxLayout, QWidget,
)

CATALOG_FILE = Path("/usr/share/darkn/catalog.json")
SELECTION_FILE = CONFIG_DIR / "selection.json"
BACKUP_FILE = CONFIG_DIR / "backup.json"
ENGINE_CMD = ["/usr/libexec/darkn-installer"]
BACKUP_CMD = ["/usr/libexec/darkn-backup"]
RESUME_UNIT = "darkn-user-setup.service"   # runs "darkn-installer --resume"
GEOIP_URL = "https://geoip.fedoraproject.org/city"
STOP_WAIT_MS = 8000

# Where the glass background comes from; the first match wins.
WALLPAPER_DIRS = [Path("/usr/share/wallpapers")]
WALLPAPER_CHOICES = ["Darkn-Macos-Mojave", "Darkn-Windows-11-Stock-Grey", "Darkn-Sagittarius-A-Black",
                     "Darkn-Jungle-Tree-Dark", "Darkn-"]

# Catalog categories shown on the developer page; terminal tools from other
# categories join them (see is_developer_item).
DEV_CATEGORIES = ("development", "vscode")
SYSTEM_TOOLS = ["Node.js 24", "Python + uv", "JDK 25", ".NET 10", "GCC / Clang", "Docker", "VS Code", "git",
                "GitHub CLI"]

# id, name, name in its own language, XKB layout, XKB variant
LAYOUTS = [
    ("us", "English (US)", "English", "us", ""),
    ("ara", "Arabic", "العربية", "ara", ""),
    ("fr", "French", "Français", "fr", ""),
    ("de", "German", "Deutsch", "de", ""),
    ("es", "Spanish", "Español", "es", ""),
    ("tr", "Turkish", "Türkçe", "tr", ""),
    ("ru", "Russian", "Русский", "ru", ""),
    ("ir", "Persian", "فارسی", "ir", ""),
    ("urdu", "Urdu", "اردو", "pk", "urd-nla"),
]
DEFAULT_LAYOUTS = ["us", "ara"]
# id, label, XKB option. Meta+Space is a Plasma shortcut and works with all of them.
SWITCHERS = [
    ("alt_shift", "Alt + Shift", "grp:alt_shift_toggle"),
    ("ctrl_shift", "Ctrl + Shift", "grp:ctrl_shift_toggle"),
    ("caps", "Caps Lock", "grp:caps_toggle"),
    ("none", "Meta + Space only", ""),
]

REAL_FILESYSTEMS = {"ext2", "ext3", "ext4", "btrfs", "xfs", "f2fs", "bcachefs", "zfs", "ntfs", "ntfs3", "fuseblk",
                    "vfat", "exfat", "nfs", "nfs4", "cifs", "smb3"}
MOUNT_ROOTS = ("/var/mnt", "/run/media", "/mnt", "/media")
BACKUP_MIN_GB, BACKUP_MAX_GB, BACKUP_DEFAULT_GB = 10, 500, 50
GIB = 1024 ** 3


# --- small tools -----------------------------------------------------------

def run_cmd(args, timeout=15):
    """Run a command and return (exit status, output); never raises.

    The output is stdout on success and the error text otherwise. Status 127
    means the program is missing, 124 that it took too long.
    """
    try:
        done = subprocess.run([str(a) for a in args], stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, encoding="utf-8", errors="replace", timeout=timeout)
    except FileNotFoundError:
        return 127, f"{args[0]} is not installed"
    except subprocess.TimeoutExpired:
        return 124, f"{args[0]} did not answer"
    except OSError as error:
        return 126, str(error)
    if done.returncode == 0:
        return 0, done.stdout
    return done.returncode, (done.stderr or done.stdout).strip()


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


def read_kconfig(path, group, key):
    """One value from a KDE config file, or None."""
    inside = False
    for line in read_text(path).splitlines():
        line = line.strip()
        if line.startswith("["):
            inside = line == f"[{group}]"
        elif inside and line.startswith(f"{key}="):
            return line.split("=", 1)[1]
    return None


def write_kconfig_file(path, group, entries):
    """Set keys of one group in a KDE config file, keeping everything else."""
    lines = read_text(path).splitlines()
    header = f"[{group}]"
    if header not in [line.strip() for line in lines]:
        lines += ([""] if lines else []) + [header]
    out, inside, left = [], False, dict(entries)

    def flush():
        while out and not out[-1].strip():
            out.pop()
        out.extend(f"{key}={value}" for key, value in left.items())
        left.clear()

    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            if inside:
                flush()
                out.append("")
            inside = stripped == header
        elif inside and "=" in stripped and stripped.split("=", 1)[0] in left:
            key = stripped.split("=", 1)[0]
            line = f"{key}={left.pop(key)}"
        out.append(line)
    if inside:
        flush()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(out) + "\n", encoding="utf-8")


def write_kconfig(file_name, group, entries):
    """Write settings with kwriteconfig6, or by editing the file if that tool is missing."""
    for key, value in entries.items():
        status, _ = run_cmd(["kwriteconfig6", "--file", file_name, "--group", group, "--key", key, value])
        if status != 0:
            break
    else:
        return True
    try:
        write_kconfig_file(CONFIG_HOME / file_name, group, entries)
        return True
    except OSError:
        return False


def fmt_size(size):
    if size is None:
        return "unknown"
    gib = size / GIB
    if gib >= 1000:
        return f"{gib / 1024:.1f} TB"
    return f"{gib:.0f} GB" if gib >= 10 else f"{gib:.1f} GB"


def plural(count, word):
    return f"{count} {word}" + ("" if count == 1 else "s")


# --- catalog and selection -------------------------------------------------

def load_catalog(path=None):
    """The catalog's categories; an empty list if the file cannot be read."""
    try:
        data = json.loads(Path(path or CATALOG_FILE).read_text(encoding="utf-8"))
        return [c for c in data["categories"] if isinstance(c.get("items"), list)]
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return []


def is_developer_item(category, item):
    """Whether an item belongs on the developer page rather than the apps page."""
    if category["id"] in DEV_CATEGORIES or item.get("page") == "developer":
        return True
    return "terminal" in item.get("description", "").lower()


def split_catalog(categories):
    """Catalog groups for the apps page and for the developer page."""
    apps, dev, terminal = [], [], []
    for category in categories:
        if category["id"] in DEV_CATEGORIES:
            dev.append(category)
            continue
        mine = [i for i in category["items"] if not is_developer_item(category, i)]
        terminal += [i for i in category["items"] if is_developer_item(category, i)]
        if mine:
            apps.append({**category, "items": mine})
    if terminal:
        dev.insert(1 if dev else 0, {"id": "terminal", "name": "Terminal tools",
                                     "description": "Assistants and agents that run in the terminal.",
                                     "items": terminal})
    return apps, dev


def catalog_ids(categories):
    return [item["id"] for category in categories for item in category["items"]]


def default_selection(categories):
    return {i["id"] for c in categories for i in c["items"] if i.get("default")}


def load_selection(categories, path=None):
    """What starts switched on: the saved selection of an earlier run, else the defaults."""
    try:
        data = json.loads(Path(path or SELECTION_FILE).read_text(encoding="utf-8"))
        return {str(i) for i in data["selected"]} & set(catalog_ids(categories))
    except (OSError, ValueError, KeyError, TypeError):
        return default_selection(categories)


def save_selection(selected, categories, path=None):
    ordered = [i for i in catalog_ids(categories) if i in selected]
    write_json(Path(path or SELECTION_FILE), {"version": 1, "selected": ordered})
    return ordered


# --- keyboard --------------------------------------------------------------

def keyboard_settings(layout_ids, switcher="alt_shift"):
    """The [Layout] entries of kxkbrc for the chosen layouts; English always comes first."""
    chosen = [layout for layout in LAYOUTS if layout[0] == "us" or layout[0] in layout_ids]
    option = next((s[2] for s in SWITCHERS if s[0] == switcher), SWITCHERS[0][2])
    return {
        "Use": "true",
        "LayoutList": ",".join(layout[3] for layout in chosen),
        "VariantList": ",".join(layout[4] for layout in chosen),
        "DisplayNames": "," * (len(chosen) - 1),
        "Options": option,
        "ResetOldOptions": "true",
    }


def read_keyboard():
    """Layout ids and switcher currently configured, falling back to the defaults."""
    for path in (CONFIG_HOME / "kxkbrc", Path("/etc/xdg/kxkbrc")):
        layouts = read_kconfig(path, "Layout", "LayoutList")
        if not layouts:
            continue
        variants = (read_kconfig(path, "Layout", "VariantList") or "").split(",")
        pairs = [(code, variants[n] if n < len(variants) else "") for n, code in enumerate(layouts.split(","))]
        ids = [layout[0] for layout in LAYOUTS if (layout[3], layout[4]) in pairs]
        options = (read_kconfig(path, "Layout", "Options") or "").split(",")
        switcher = next((s[0] for s in SWITCHERS if s[2] and s[2] in options), "none")
        return ids or list(DEFAULT_LAYOUTS), switcher
    return list(DEFAULT_LAYOUTS), "alt_shift"


def apply_keyboard(layout_ids, switcher):
    if not write_kconfig("kxkbrc", "Layout", keyboard_settings(layout_ids, switcher)):
        return False, "Could not save the keyboard layouts"
    run_cmd(["dbus-send", "--session", "--type=signal", "/Layouts", "org.kde.keyboard.reloadConfig"])
    return True, ""


# --- region and time -------------------------------------------------------

def parse_geoip(text):
    """Time zone and place name from the answer of Fedora's location service."""
    try:
        data = json.loads(text)
        zone = data.get("time_zone")
    except (ValueError, AttributeError):
        return None
    if not zone or not isinstance(zone, str):
        return None
    place = ", ".join(str(data[k]) for k in ("city", "country_name") if data.get(k))
    return {"zone": zone, "place": place}


def fetch_geoip():
    try:
        request = urllib.request.Request(GEOIP_URL, headers={"User-Agent": "darkn-welcome"})
        with urllib.request.urlopen(request, timeout=8) as response:
            return parse_geoip(response.read(65536).decode("utf-8", "replace"))
    except (OSError, ValueError):
        return None


def list_timezones():
    status, out = run_cmd(["timedatectl", "list-timezones"])
    zones = out.split() if status == 0 else []
    if not zones:
        try:
            import zoneinfo
            zones = sorted(z for z in zoneinfo.available_timezones() if "/" in z and not z.startswith("Etc/"))
        except Exception:
            zones = []
    return zones or ["UTC"]


def current_timezone():
    status, out = run_cmd(["timedatectl", "show", "-p", "Timezone", "--value"])
    if status == 0 and out.strip():
        return out.strip()
    try:
        target = os.readlink("/etc/localtime")
        return target.split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


def load_time_info():
    return {"zones": list_timezones(), "current": current_timezone()}


def clock_locale(hours24):
    return "en_GB.UTF-8" if hours24 else "en_US.UTF-8"


def read_clock():
    """True if the clock is currently set to 24 hours."""
    value = read_kconfig(CONFIG_HOME / "plasma-localerc", "Formats", "LC_TIME")
    return bool(value) and not value.startswith("en_US")


def format_clock(zone, hours24, now=None):
    """Time and date in a zone, e.g. ("3:42 PM", "Tuesday, 10 November")."""
    if now is None:
        try:
            import zoneinfo
            now = datetime.now(zoneinfo.ZoneInfo(zone))
        except Exception:
            now = datetime.now()
    clock = now.strftime("%H:%M") if hours24 else now.strftime("%I:%M %p").lstrip("0")
    return clock, f"{now.strftime('%A')}, {now.day} {now.strftime('%B')}"


def apply_region(zone, current, hours24, write_clock):
    problems = []
    if zone and zone != current:
        # May ask for the password; give the prompt time.
        status, out = run_cmd(["timedatectl", "set-timezone", zone], timeout=180)
        if status != 0:
            reason = out.splitlines()[-1] if out else "no permission"
            problems.append(f"The time zone was not changed ({reason}); set it in System Settings, Date and Time")
    if write_clock and not write_kconfig("plasma-localerc", "Formats", {"LC_TIME": clock_locale(hours24)}):
        problems.append("Could not save the clock format")
    return not problems, ". ".join(problems)


# --- hardware --------------------------------------------------------------

GPU_VENDORS = {"10de": ("nvidia", "NVIDIA"), "1002": ("amd", "AMD"), "1022": ("amd", "AMD"), "8086": ("intel", "Intel")}
GPU_LINE = re.compile(r"^\S+\s+(?:VGA compatible controller|3D controller|Display controller)\s*\[[0-9a-f]{4}\]:\s*"
                      r"(.*?)\s*\[([0-9a-f]{4}):[0-9a-f]{4}\]", re.IGNORECASE)
VENDOR_PREFIX = re.compile(r"^(NVIDIA Corporation|Advanced Micro Devices, Inc\.(\s*\[AMD/ATI\])?|"
                           r"Intel Corporation)\s*", re.IGNORECASE)


def parse_gpus(lspci):
    """Graphics cards from `lspci -nn`: vendor key, display name and the raw description."""
    gpus = []
    for line in lspci.splitlines():
        match = GPU_LINE.match(line.strip())
        if not match:
            continue
        raw, vendor_id = match.group(1), match.group(2).lower()
        vendor, brand = GPU_VENDORS.get(vendor_id, ("other", ""))
        model = VENDOR_PREFIX.sub("", raw)
        named = re.findall(r"\[([^\]]+)\]", model)
        model = named[-1] if named else model
        gpus.append({"vendor": vendor, "name": f"{brand} {model}".strip(), "raw": raw})
    return gpus


def open_driver_supports(description):
    """Whether NVIDIA's open driver covers a card: True, False, or None if unclear.

    It needs a GTX 16 series card (Turing) or newer.
    """
    if re.search(r"\bRTX\b|GTX 16\d\d|\b(TU|GA|AD|GB)\d{3}", description):
        return True
    if re.search(r"\bGTX?\b|\b(GV|GP|GM|GK|GF)\d{3}|\bNV[0-9A-F]{2}\b|Quadro [KMP]\d", description):
        return False
    return None


def gpu_status(lspci, nvidia_version="", nvidia_smi="", secure_boot=""):
    """What to tell the user about their graphics card.

    Takes the output of `lspci -nn`, the text of /proc/driver/nvidia/version,
    of `nvidia-smi --query-gpu=name,driver_version --format=csv,noheader` and
    of `mokutil --sb-state`. Level is "ok", "warn", "info" or "none".
    """
    gpus = parse_gpus(lspci)
    names = [gpu["name"] for gpu in gpus]
    result = {"gpus": names, "driver": "", "hints": []}
    nvidia = [gpu for gpu in gpus if gpu["vendor"] == "nvidia"]

    if not gpus:
        return {**result, "level": "none", "title": "No graphics card detected",
                "detail": "The graphics hardware could not be identified, which is normal in a virtual "
                          "machine. The desktop still works with the generic driver."}
    if not nvidia:
        return {**result, "level": "info", "title": "Works with the built-in drivers",
                "detail": f"{' and '.join(names)} works with the built-in open-source drivers. "
                          "The NVIDIA driver in this image is simply unused."}

    smi = [part.strip() for part in nvidia_smi.strip().splitlines()[0].split(",")] if nvidia_smi.strip() else []
    version = re.search(r"\b(\d{3}\.\d+(?:\.\d+)?)\b", nvidia_version)
    if version or len(smi) >= 2:
        driver = version.group(1) if version else smi[-1]
        return {**result, "level": "ok", "driver": driver, "title": "Supported, driver active",
                "detail": f"{nvidia[0]['name']} is running on the NVIDIA driver {driver} that ships with Darkn OS."}

    supported = open_driver_supports(nvidia[0]["raw"])
    too_old = {"text": "The card is older than the GTX 1650. NVIDIA's open driver only supports the GTX 16 "
                       "series, RTX and newer; older cards keep working on the slower built-in driver.",
               "command": "", "likely": supported is False}
    locked = {"text": "Secure Boot is on and the Universal Blue key is not enrolled. Run this in a terminal, "
                      "restart, and confirm the key on the blue screen that appears.",
              "command": "ujust enroll-secure-boot-key",
              "likely": supported is True and "enabled" in secure_boot.lower()}
    return {**result, "level": "warn", "title": "NVIDIA driver is not active",
            "detail": f"Darkn OS ships NVIDIA's open driver, but it is not running on {nvidia[0]['name']}. "
                      "There are two usual causes.",
            "hints": [too_old, locked] if supported is False else [locked, too_old]}


def parse_cpu(cpuinfo):
    match = re.search(r"^model name\s*:\s*(.+)$", cpuinfo, re.MULTILINE)
    name = match.group(1) if match else ""
    name = re.sub(r"\((R|TM)\)|\bCPU\b|\b\d+-Core Processor\b|@.*$", " ", name, flags=re.IGNORECASE)
    return " ".join(name.split())


def parse_memory(meminfo):
    """Installed memory in whole GB (the kernel reports slightly less than what is fitted)."""
    match = re.search(r"^MemTotal:\s*(\d+)\s*kB", meminfo, re.MULTILINE)
    return -(-int(match.group(1)) // (1024 * 1024)) if match else 0


def detect_hardware():
    status, lspci = run_cmd(["lspci", "-nn"])
    lspci = lspci if status == 0 else ""
    version = read_text("/proc/driver/nvidia/version")
    smi = ""
    if not version and "[10de:" in lspci.lower():
        status, out = run_cmd(["nvidia-smi", "--query-gpu=name,driver_version", "--format=csv,noheader"])
        smi = out if status == 0 else ""
    status, secure_boot = run_cmd(["mokutil", "--sb-state"])
    return {
        "gpu": gpu_status(lspci, version, smi, secure_boot if status == 0 else ""),
        "cpu": parse_cpu(read_text("/proc/cpuinfo")),
        "cores": os.cpu_count() or 0,
        "memory": parse_memory(read_text("/proc/meminfo")),
    }


# --- backups ---------------------------------------------------------------

def parse_findmnt(text):
    """Mounts from `findmnt -J -l -b -o TARGET,SOURCE,FSTYPE,AVAIL,SIZE`."""
    def number(value):
        try:
            return int(value)
        except (TypeError, ValueError):
            return None

    def walk(entries):
        for entry in entries or []:
            if isinstance(entry, dict) and entry.get("target"):
                yield {"target": str(entry["target"]), "source": str(entry.get("source") or ""),
                       "fstype": str(entry.get("fstype") or ""), "avail": number(entry.get("avail")),
                       "size": number(entry.get("size"))}
                yield from walk(entry.get("children"))

    try:
        return list(walk(json.loads(text).get("filesystems")))
    except (ValueError, AttributeError):
        return []


def parse_lsblk(text):
    """Parent of every block device, from `lsblk -J -l -o PATH,KNAME,PKNAME`."""
    parents = {}

    def walk(entries):
        for entry in entries or []:
            if isinstance(entry, dict):
                for key in ("path", "kname"):
                    if entry.get(key):
                        parents[str(entry[key])] = entry.get("pkname") or None
                walk(entry.get("children"))

    try:
        walk(json.loads(text).get("blockdevices"))
    except (ValueError, AttributeError):
        pass
    return parents


def disk_of(source, parents=None):
    """The physical drive behind a mount source, or None if it cannot be told."""
    source = re.sub(r"\[.*\]$", "", source or "")  # btrfs subvolumes read /dev/sda2[/home]
    if not source.startswith("/dev/"):
        return None
    if parents and source in parents:
        name = Path(source).name
        parent = parents[source]
        while parent:
            name, parent = parent, parents.get(parent)
        return name
    name = Path(source).name
    match = re.fullmatch(r"((?:nvme|mmcblk)\d+(?:n\d+)?)p\d+|([a-z]+)\d+", name)
    return (match.group(1) or match.group(2)) if match else name


real_path = os.path.realpath  # /home is a link to /var/home on this system; tests replace this


def mount_of(path, mounts):
    """The mount a path lives on (the longest mount point that contains it)."""
    path = real_path(str(path))
    best = None
    for mount in mounts:
        target = mount["target"].rstrip("/")
        if (path == target or path.startswith(target + "/")) and (best is None or len(target) > len(best["target"].rstrip("/"))):
            best = mount
    return best


def disk_space(path):
    """(free, total) bytes of the drive holding a path that may not exist yet."""
    path = Path(path)
    while not path.exists() and path.parent != path:
        path = path.parent
    try:
        usage = shutil.disk_usage(path)
        return usage.free, usage.total
    except OSError:
        return None, None


def backup_places(mounts, home, parents=None, writable=None):
    """Where backups can go: the home drive first, then every other mounted drive."""
    writable = writable or (lambda target: os.access(target, os.W_OK))
    home = str(home)
    home_mount = mount_of(home, mounts)
    home_disk = disk_of(home_mount["source"], parents) if home_mount else None
    free, total = (home_mount["avail"], home_mount["size"]) if home_mount else disk_space(home)
    places = [{"kind": "home", "label": "Home drive", "path": f"{home.rstrip('/')}/Backups",
               "avail": free, "size": total, "same_drive": True}]
    for mount in mounts:
        target = mount["target"]
        if mount is home_mount or mount["fstype"] not in REAL_FILESYSTEMS:
            continue
        if not any(target.startswith(root + "/") for root in MOUNT_ROOTS) or not writable(target):
            continue
        disk = disk_of(mount["source"], parents)
        places.append({"kind": "drive", "label": Path(target).name, "path": f"{target.rstrip('/')}/Backups",
                       "avail": mount["avail"], "size": mount["size"],
                       "same_drive": bool(disk) and disk == home_disk})
    return places


def place_for_path(path, mounts, home, parents=None):
    """A backup place for a folder the user browsed to."""
    path = str(path)
    mount, home_mount = mount_of(path, mounts), mount_of(str(home), mounts)
    if mount:
        disk, home_disk = disk_of(mount["source"], parents), disk_of(home_mount["source"], parents) if home_mount else None
        same = mount is home_mount or (bool(disk) and disk == home_disk)
        free, total = mount["avail"], mount["size"]
    else:
        same = real_path(path).startswith(real_path(str(home)))
        free, total = disk_space(path)
    return {"kind": "custom", "label": Path(path).name or path, "path": path, "avail": free, "size": total,
            "same_drive": same}


def limit_range(avail):
    """Smallest and largest backup size limit in GB for a drive with `avail` free bytes."""
    if avail is None:
        return BACKUP_MIN_GB, BACKUP_MAX_GB
    high = max(1, min(BACKUP_MAX_GB, avail // GIB))
    return min(BACKUP_MIN_GB, high), high


def clamp_limit(value, avail):
    low, high = limit_range(avail)
    return max(low, min(high, int(value)))


def load_backup():
    try:
        data = json.loads(BACKUP_FILE.read_text(encoding="utf-8"))
        return {"enabled": bool(data["enabled"]), "destination": str(data["destination"]),
                "max_gb": int(data["max_gb"])}
    except (OSError, ValueError, KeyError, TypeError):
        return None


def read_backup_key():
    status, key = run_cmd([*BACKUP_CMD, "key"])
    return key.strip() if status == 0 else ""


def apply_backup(enabled, destination, max_gb):
    """Save the backup settings and switch backups on or off. Returns (ok, message, recovery key)."""
    try:
        write_json(BACKUP_FILE, {"enabled": bool(enabled), "destination": str(destination), "max_gb": int(max_gb)})
    except OSError as error:
        return False, f"Could not save the backup settings: {error}", ""
    status, out = run_cmd([*BACKUP_CMD, "init" if enabled else "disable"], timeout=180)
    if status == 127:
        return False, "The backup tool is missing; your choice was saved", ""
    if status != 0:
        return False, out.splitlines()[-1] if out else "The backup tool reported an error", ""
    if not enabled:
        return True, "", ""
    return True, "", read_backup_key()


def check_online():
    try:
        socket.create_connection(("github.com", 443), timeout=4).close()
        return True
    except OSError:
        return False


def mark_done():
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        DONE_FILE.write_text(time.strftime("%Y-%m-%d %H:%M:%S") + "\n", encoding="utf-8")
    except OSError:
        pass


