[Unit]
Description=Darkn OS: resume an interrupted app install
Documentation=file:///usr/libexec/darkn-installer
After=graphical-session.target ublue-user-setup.service
ConditionUser=!@system

[Service]
Type=oneshot
ExecStart=/usr/libexec/darkn-installer --resume
# Downloads can take a long time; never kill the run on a start timeout.
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=120
Nice=10

[Install]
WantedBy=graphical-session.target
