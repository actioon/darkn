#!/usr/bin/env bash
# Darkn OS backups.
#
# Encrypted, incremental backups of the home folder with restic. The first
# run copies everything; later runs only store what changed. Old backups are
# thinned out, and the oldest are dropped when the size limit is reached.
#
# Settings: ~/.config/darkn/backup.json
#   {"enabled": true, "destination": "/path/to/folder", "max_gb": 50}
# Recovery key: ~/.config/darkn/backup.key (needed to read the backups)
#
#   darkn-backup init       create the backup store and switch the schedule on
#   darkn-backup run        back up now
#   darkn-backup status     where, how big, how many backups
#   darkn-backup list       list backups
#   darkn-backup key        print the recovery key
#   darkn-backup restore <backup-id|latest> <folder>   restore into a folder
#   darkn-backup browse <folder>    mount all backups as a folder to browse
#   darkn-backup disable    stop the schedule (existing backups are kept)

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/darkn"
CONFIG="${CONFIG_DIR}/backup.json"
KEY_FILE="${CONFIG_DIR}/backup.key"
EXCLUDES="/usr/share/darkn/backup-excludes.txt"
TIMER="darkn-backup.timer"

die() { echo "darkn-backup: $*" >&2; exit 1; }

setting() { jq -r "$1 // empty" "$CONFIG" 2>/dev/null; }

load() {
    [[ -f "$CONFIG" ]] || die "no settings yet; run the Darkn OS setup (darkn-setup) or create ${CONFIG}"
    DEST="$(setting .destination)"
    MAX_GB="$(setting .max_gb)"
    ENABLED="$(setting .enabled)"
    [[ -n "$DEST" ]] || die "no destination set in ${CONFIG}"
    [[ "$MAX_GB" =~ ^[0-9]+$ ]] || MAX_GB=50
    REPO="${DEST%/}/darkn-backup-${USER}"
    export RESTIC_REPOSITORY="$REPO"
    export RESTIC_PASSWORD_FILE="$KEY_FILE"
    export RESTIC_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/darkn/restic"
}

ensure_key() {
    if [[ ! -s "$KEY_FILE" ]]; then
        mkdir -p "$CONFIG_DIR"
        (umask 077; head -c 32 /dev/urandom | base64 | tr -d '\n' >"$KEY_FILE")
    fi
    chmod 600 "$KEY_FILE"
}

ensure_repo() {
    mkdir -p "$REPO" || die "cannot write to ${DEST}"
    if ! restic cat config >/dev/null 2>&1; then
        restic init >/dev/null || die "could not create the backup store in ${REPO}"
    fi
}

repo_bytes() { du -sb "$REPO" 2>/dev/null | cut -f1; }

# Drop the oldest backups until the store fits the size limit (always keep one).
enforce_limit() {
    local limit=$((MAX_GB * 1024 * 1024 * 1024)) oldest count
    while (( $(repo_bytes) > limit )); do
        count="$(restic snapshots --json 2>/dev/null | jq 'length')"
        (( ${count:-0} > 1 )) || break
        oldest="$(restic snapshots --json | jq -r 'sort_by(.time) | .[0].short_id')"
        [[ -n "$oldest" && "$oldest" != "null" ]] || break
        restic forget "$oldest" --prune >/dev/null || break
    done
}

cmd_run() {
    load
    [[ "$ENABLED" == "true" ]] || { echo "Backups are turned off."; exit 0; }
    ensure_key
    ensure_repo
    restic unlock >/dev/null 2>&1
    local args=(backup "$HOME" --one-file-system --exclude-caches --tag darkn)
    [[ -f "$EXCLUDES" ]] && args+=(--exclude-file "$EXCLUDES")
    # Never back up the backup store into itself.
    args+=(--exclude "$REPO")
    restic "${args[@]}"
    local status=$?
    # 3 means some files could not be read; the backup itself was still made.
    if (( status != 0 && status != 3 )); then
        notify-send --app-name="Darkn OS" --icon=dialog-error "Backup failed" \
            "The backup to ${DEST} did not finish. Run: darkn-backup run" 2>/dev/null
        exit "$status"
    fi
    restic forget --tag darkn --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >/dev/null
    enforce_limit
    echo "Backup finished. Store size: $(du -sh "$REPO" | cut -f1) of ${MAX_GB}G."
}

cmd_init() {
    load
    ensure_key
    ensure_repo
    systemctl --user enable --now "$TIMER" >/dev/null 2>&1 || true
    echo "Backups are on. Store: ${REPO} (limit ${MAX_GB} GB)."
    echo "Keep your recovery key somewhere safe: darkn-backup key"
}

cmd_disable() {
    systemctl --user disable --now "$TIMER" >/dev/null 2>&1 || true
    echo "Scheduled backups are off. Existing backups were not deleted."
}

cmd_status() {
    load
    echo "Enabled:     ${ENABLED:-false}"
    echo "Destination: ${REPO}"
    echo "Limit:       ${MAX_GB} GB"
    if [[ -d "$REPO" ]]; then
        echo "Size:        $(du -sh "$REPO" | cut -f1)"
        echo "Backups:     $(restic snapshots --json 2>/dev/null | jq 'length')"
        echo "Latest:      $(restic snapshots --json 2>/dev/null | jq -r 'sort_by(.time) | last | .time // "none"')"
    else
        echo "No backup has been made yet."
    fi
    systemctl --user is-enabled "$TIMER" >/dev/null 2>&1 && echo "Schedule:    daily" || echo "Schedule:    off"
}

case "${1:-}" in
    init)    cmd_init ;;
    run)     cmd_run ;;
    disable) cmd_disable ;;
    status)  cmd_status ;;
    list)    load; restic snapshots ;;
    key)     [[ -s "$KEY_FILE" ]] || die "no recovery key yet (backups were never set up)"; cat "$KEY_FILE"; echo ;;
    restore)
        load
        [[ $# -eq 3 ]] || die "usage: darkn-backup restore <backup-id|latest> <folder>"
        mkdir -p "$3" && restic restore "$2" --target "$3"
        ;;
    browse)
        load
        [[ $# -eq 2 ]] || die "usage: darkn-backup browse <folder>"
        mkdir -p "$2" && echo "Backups are available in $2 until you press Ctrl+C." && restic mount "$2"
        ;;
    *)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
