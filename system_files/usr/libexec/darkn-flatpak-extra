#!/usr/bin/env bash
# Darkn OS: register the official ArtCraft Flatpak repository system-wide.
#
# The repository definition, with ArtCraft's GPG key, ships in the image so
# the key is fixed at build time rather than fetched at run time. Nothing is
# installed here: the setup wizard installs only the apps the user picks.

set -uo pipefail

REMOTE="artcraft-oci"
REPO_FILE="/usr/share/darkn/artcraft-oci.flatpakrepo"

flatpak remote-add --system --if-not-exists "$REMOTE" "$REPO_FILE"
