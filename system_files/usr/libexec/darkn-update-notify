#!/usr/bin/env bash
# Darkn OS: tell the user when updates are available. Nothing is installed
# here; "Update now" opens Aurora's System Update (ujust update).

set -uo pipefail

parts=()

# Exit status 0 means a newer system image exists, 77 means up to date.
if command -v rpm-ostree >/dev/null 2>&1; then
    rpm-ostree upgrade --check >/dev/null 2>&1
    [[ $? -eq 0 ]] && parts+=("a new system version")
fi

apps="$(flatpak remote-ls --updates --columns=application 2>/dev/null | grep -c .)"
if (( apps > 0 )); then
    parts+=("${apps} app update(s)")
fi

(( ${#parts[@]} > 0 )) || exit 0

message="$(printf '%s, ' "${parts[@]}")"
message="Available: ${message%, }."

action="$(notify-send --app-name="Darkn OS" --icon=system-software-update \
    --action=update="Update now" --action=later="Later" \
    "Updates available" "$message" 2>/dev/null)"

if [[ "$action" == "update" ]]; then
    kioclient exec /usr/share/applications/dev.getaurora.system-update.desktop >/dev/null 2>&1 ||
        konsole -e ujust update
fi
exit 0
