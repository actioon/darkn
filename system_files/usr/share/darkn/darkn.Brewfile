# Darkn OS developer tools installed per user through Homebrew on first login.
# Homebrew keeps them current afterwards (brew-upgrade.timer).

tap "ublue-os/tap"
tap "ublue-os/experimental-tap"

# AI coding CLIs
cask "claude-code"
cask "codex"
cask "copilot-cli"
brew "gemini-cli"
brew "opencode"

# AI desktop apps (official vendor packages, repackaged by Universal Blue)
cask "ublue-os/experimental-tap/claude-desktop-linux"
cask "ublue-os/experimental-tap/chatgpt-linux"
cask "ublue-os/experimental-tap/opencode-desktop-linux"
cask "ublue-os/tap/antigravity-linux"
cask "ublue-os/tap/antigravity-ide-linux"

# Editors
cask "ublue-os/experimental-tap/cursor-linux"

# Misc CLI
tap "supabase/tap"
brew "supabase/tap/supabase"
brew "cloudflared"
