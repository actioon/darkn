# Darkn OS default apps.
# Installed automatically by flatpak-preinstall.service once the machine is
# online, always at the latest Flathub version. Removing an app afterwards is
# respected: Flatpak does not reinstall it.

# --- Desktop basics ---
# Aurora's own ISO installs these, but they are not part of the image, so a
# Darkn OS install has to ask for them itself.
[Flatpak Preinstall org.kde.haruna]
Branch=stable
IsRuntime=false

# KDE Photos (Koko): gallery and image viewer, replaces Gwenview
[Flatpak Preinstall org.kde.koko]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.kde.okular]
Branch=stable
IsRuntime=false

# Qalculate!: scientific, programmer, unit and currency calculator, replaces KCalc
[Flatpak Preinstall io.github.Qalculate.qalculate-qt]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.github.flattool.Warehouse]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.missioncenter.MissionCenter]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.fkoehler.KTailctl]
Branch=stable
IsRuntime=false

# Live and interactive wallpapers (its Plasma plugin is installed by build.sh)
[Flatpak Preinstall org.waywallen.waywallen]
Branch=stable
IsRuntime=false

# Razer devices: lighting, DPI and polling rate (uses the OpenRazer driver in the image)
[Flatpak Preinstall app.polychromatic.controller]
Branch=stable
IsRuntime=false

# --- Browsers (Brave is the default, see /etc/xdg/mimeapps.list) ---
[Flatpak Preinstall com.brave.Browser]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.mozilla.firefox]
Branch=stable
IsRuntime=false

# --- Chat ---
[Flatpak Preinstall org.telegram.desktop]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.discordapp.Discord]
Branch=stable
IsRuntime=false

# WhatsApp has no official Linux app; ZapZap is the WhatsApp client on Flathub.
[Flatpak Preinstall com.rtosta.zapzap]
Branch=stable
IsRuntime=false

# --- Notes / office ---
[Flatpak Preinstall md.obsidian.Obsidian]
Branch=stable
IsRuntime=false

# The ArtCraft office and design apps come from ArtCraft's own repository,
# see /usr/share/darkn/artcraft-flatpaks.list. OnlyOffice is the stable fallback.
[Flatpak Preinstall org.onlyoffice.desktopeditors]
Branch=stable
IsRuntime=false

# --- Security ---
[Flatpak Preinstall com.bitwarden.desktop]
Branch=stable
IsRuntime=false

# --- Screen recording and video editing ---
[Flatpak Preinstall com.obsproject.Studio]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.kde.kdenlive]
Branch=stable
IsRuntime=false

# --- Media (Haruna, the default player, is listed under Desktop basics) ---
[Flatpak Preinstall org.videolan.VLC]
Branch=stable
IsRuntime=false

# Equalizer, microphone noise removal, compressor and limiter for PipeWire
# (the open-source counterpart of Equalizer APO and NVIDIA Broadcast audio).
[Flatpak Preinstall com.github.wwmm.easyeffects]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.audacityteam.Audacity]
Branch=stable
IsRuntime=false

[Flatpak Preinstall fr.handbrake.ghb]
Branch=stable
IsRuntime=false

# --- Development ---
[Flatpak Preinstall com.google.AndroidStudio]
Branch=stable
IsRuntime=false

# API client (open source, works offline, no account)
[Flatpak Preinstall com.usebruno.Bruno]
Branch=stable
IsRuntime=false

# Database manager for PostgreSQL, MySQL/MariaDB and SQL Server
[Flatpak Preinstall io.dbeaver.DBeaverCommunity]
Branch=stable
IsRuntime=false

[Flatpak Preinstall net.poedit.Poedit]
Branch=stable
IsRuntime=false
