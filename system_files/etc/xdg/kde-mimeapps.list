# Darkn OS system-wide default applications.
# Brave is the default browser; Firefox takes over if Brave is not installed.
# A user's own choice in System Settings > Default Applications overrides this.

[Default Applications]
x-scheme-handler/http=com.brave.Browser.desktop;org.mozilla.firefox.desktop;
x-scheme-handler/https=com.brave.Browser.desktop;org.mozilla.firefox.desktop;
text/html=com.brave.Browser.desktop;org.mozilla.firefox.desktop;
application/xhtml+xml=com.brave.Browser.desktop;org.mozilla.firefox.desktop;
